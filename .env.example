PORT=3000
DB_PATH=./data/monitor.db
# Optional: Neon / PostgreSQL connection string (used automatically when set)
# DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Optional: Secret for /api/cron/check and stateless session signing
# CRON_SECRET=replace-with-random-secret
# SESSION_SECRET=replace-with-random-secret

# Admin Login Credentials (seeded on first startup if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# SMTP Configuration for multi-recipient email alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Uptime Sentinel <alerts@yourdomain.com>

# Comma-separated global alert recipients (always notified alongside per-monitor emails)
GLOBAL_ALERT_EMAILS=oncall@yourdomain.com,devops@yourdomain.com
